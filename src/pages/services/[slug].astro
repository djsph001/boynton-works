---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.active);
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const providers = await getCollection('providers');
const provider = providers.find(p => p.id === service.data.provider);
const categories = await getCollection('categories');
const category = categories.find(c => c.id === service.data.category);
const { Content } = await render(service);
---

<Base title={service.data.name} description={service.data.summary}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/browse">Browse</a>
      {category && <span> / {category.data.name}</span>}
    </nav>
    <h1>{service.data.name}</h1>
    {provider && (
      <p class="service-provider">
        by <a href={`/providers/${provider.id}`}>{provider.data.name}</a>
      </p>
    )}
    <div class="service-meta">
      <span>{service.data.priceRange}</span>
      <span>{service.data.deliveryTime}</span>
      {service.data.remote && <span>Remote OK</span>}
      {service.data.inPerson && <span>In-person OK</span>}
    </div>
    <div class="service-body">
      <Content />
    </div>
    {provider && (
      <div class="contact-box">
        <h2>Contact {provider.data.name}</h2>
        <p>Email: <a href={`mailto:${provider.data.email}`}>{provider.data.email}</a></p>
        {provider.data.phone && <p>Phone: <a href={`tel:${provider.data.phone}`}>{provider.data.phone}</a></p>}
      </div>
    )}
  </div>
</Base>
