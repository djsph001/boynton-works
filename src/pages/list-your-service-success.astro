---
import Base from '../layouts/Base.astro';
---

<Base title="Listing received" description="Thank you for listing your service on Boynton Works.">
  <div class="container">
    <h1>Listing received</h1>
    <p class="page-intro">
      Thank you. Your service has been submitted for review.
    </p>
    <p>
      We review every listing to make sure it fits the community.
      If it does, it will appear on the site within a few days.
      You will not receive a confirmation email unless we have a question.
    </p>
    <p>
      <a href="/" class="btn btn-primary">Back to Boynton Works</a>
    </p>
  </div>
</Base>
